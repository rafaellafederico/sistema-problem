# Número para alertas diretos (formato: DDI+DDD+número)
ALERT_PHONE_NUMBER=5511999999999

# ─── n8n ──────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=troque_esta_senha_forte

# ─── URLs ─────────────────────────────────────────────────────────────────────
